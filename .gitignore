# worker-configuration.d.ts is deliberately NOT ignored.
#
# It is generated by `wrangler types`, but the build needs it: without it the
# Env interface and D1Database are undefined and tsc fails. A CI runner clones
# the repo and never runs the generator, so it has to be committed. It holds
# only type declarations — no secrets. Regenerate with `npm run cf-typegen`
# after changing wrangler.jsonc.
